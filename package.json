{
  "name": "crud-ts",
  "version": "1.0.0",
  "description": "This application allows user to create new product, update existing product and user is able to filter product by product id and able to sort it by productId, Product Name and Price.",
  "type": "module",
  "scripts": {
    "dev": "parcel serve ./src/index.html --port 3000",
    "type-check": "tsc -b --noEmit",
    "lint": "eslint src --ext .ts --cache --fix",
    "build": "rm -rf dist .parcel-cache && npm run type-check && npm run lint && parcel build ./src/index.html --no-autoinstall --no-optimize",
    "format": "prettier src --write"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dhruvdhaduk-simform/crud-ts.git"
  },
  "keywords": [
    "crud",
    "product",
    "create",
    "read",
    "update",
    "delete",
    "filter"
  ],
  "author": "Dhruv Dhaduk",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/dhruvdhaduk-simform/crud-ts/issues"
  },
  "homepage": "https://github.com/dhruvdhaduk-simform/crud-ts#readme",
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "eslint": "^9.23.0",
    "globals": "^16.0.0",
    "parcel": "^2.14.2",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.28.0"
  }
}
